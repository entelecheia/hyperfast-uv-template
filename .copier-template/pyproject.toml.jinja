[project]
name = "{{ project_name }}"
version = "0.0.0"
description = "{{ project_short_description }}"
authors = [{ name = "{{ author }}", email = "{{ email }}" }]
{% if project_license != 'None' -%}
license = "{{ project_license }}"
{% endif -%}
readme = "README.md"
requires-python = ">=3.11"
keywords = ["python"]
classifiers = [
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3.14",
    "Programming Language :: Python :: 3.15",
    "Typing :: Typed",
]
dependencies = []

[project.urls]
Homepage = "{{ documentation_url if docs_tool == 'mkdocs' else 'https://github.com/' ~ github_username ~ '/' ~ github_repo_name }}"
Repository = "https://github.com/{{ github_username }}/{{ github_repo_name }}"
{% if docs_tool == 'mkdocs' -%}
Documentation = "{{ documentation_url }}"
{% endif -%}
Changelog = "https://github.com/{{ github_username }}/{{ github_repo_name }}/blob/{{ main_branch }}/CHANGELOG.md"
{% if package_scripts %}
[project.scripts]
{% for script in package_scripts -%}
{{ script }}
{% endfor -%}
{% endif %}
[dependency-groups]
test = ["pytest>=9", "pytest-cov>=7"]
lint = ["ruff>=0.17", "mypy>=2"]
{% if docs_tool == 'mkdocs' -%}
docs = ["mkdocs>=1.6,<2", "mkdocs-material>=9.7"]
dev = [{ include-group = "test" }, { include-group = "lint" }, { include-group = "docs" }]
{% else -%}
dev = [{ include-group = "test" }, { include-group = "lint" }]
{% endif %}
[tool.uv]
default-groups = ["dev"]
required-version = ">=0.12"

[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
target-version = "py311"
line-length = 120
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "SIM", "S", "C4", "A", "C90", "PGH", "RUF", "T10", "YTT"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["S101", "S603", "S607"]

[tool.mypy]
python_version = "3.11"
files = ["src/{{ package_name }}"]
strict = true
ignore_missing_imports = true

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-p no:cacheprovider"

[tool.coverage.run]
branch = true
source = ["{{ package_name }}"]

[tool.coverage.report]
skip_empty = true
show_missing = true
exclude_lines = ["pragma: no cover", "if TYPE_CHECKING:", 'if __name__ == "__main__":']

[tool.semantic_release]
tag_format = "v{version}"
commit_parser = "conventional"
major_on_zero = true
allow_zero_version = true
version_source = "tag"
commit_message = ":rocket: {version}\n\nAutomatically generated by python-semantic-release"
# Runs inside the semantic-release action container: pin uv, refresh this
# package's entry in the committed uv.lock, then build sdist and wheel.
build_command = "pip install uv==0.13.2 && uv lock --upgrade-package \"$PACKAGE_NAME\" && git add uv.lock && uv build"
version_toml = ["pyproject.toml:project.version"]
version_variables = ["src/{{ package_name }}/_version.py:__version__"]

[tool.semantic_release.branches.main]
match = "release"
prerelease = false

[tool.semantic_release.changelog]
insertion_flag = "<!--next-version-placeholder-->"
mode = "update"

[tool.semantic_release.remote]
type = "github"
token = { env = "GH_TOKEN" }

[tool.semantic_release.publish]
dist_glob_patterns = ["dist/*"]
upload_to_vcs_release = true
